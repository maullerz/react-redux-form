{
  "plugins": [
    ["transform-react-remove-prop-types", {"mode": "wrap"}]
  ],
  "presets": [
    ["es2015", {"modules": false}],
    "react",
    "stage-2"
  ],
  "env": {
    "test": {
      "presets": [
        ["es2015", {"modules": "commonjs"}],
        "react",
        "stage-2"
      ]
    }
  }
}
